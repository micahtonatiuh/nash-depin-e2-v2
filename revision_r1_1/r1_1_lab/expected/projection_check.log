eps= 1.0: data around handover(right,up) -> greedy (up,stay) [hold];  around hold(stay,stay) -> greedy (up,stay) [hold]
eps= 0.5: data around handover(right,up) -> greedy (down,up) [handover];  around hold(stay,stay) -> greedy (stay,stay) [hold]
eps= 0.2: data around handover(right,up) -> greedy (down,up) [handover];  around hold(stay,stay) -> greedy (left,left) [hold]
eps=0.05: data around handover(right,up) -> greedy (down,up) [handover];  around hold(stay,stay) -> greedy (stay,left) [hold]
